# JWT Configuration
JWT_SECRET_KEY="your-secret-key"

# Configuration App
HOST=0.0.0.0
PORT=5000
DEBUG_MODE=False

# DB Configuration
CONNECTION_STRING="your-connection-string-to-mongodb"
DB_NAME="your-db-name"

# Optional Firebase Cloud Messaging credentials for Android push notifications
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_FILE="/etc/secrets/firebase-service-account.json"
